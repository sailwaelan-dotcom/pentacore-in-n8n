# Copier en .env (jamais versionne) et renseigner.
# Cle OpenRouter utilisee par Kilo pour le vrai LLM. Sans elle, seul l'agent
# scripte (mode demo) fonctionne.
OPENROUTER_API_KEY=
# Modele Kilo du Backend Lead (format provider/modele de `kilo models`).
PENTACORE_MODELE=openrouter/~deepseek/deepseek-flash-latest
# Duree maximale d'un stage en secondes (n8n ne surveille pas le silence).
PENTACORE_DUREE_MAX_S=2700
